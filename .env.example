# 本文件用于本机入口；在线目录验证使用独立配置，见 docs/guides/hosted-workspace-validation.md。
RELEASE_HARBOR_MODE=local
RELEASE_HARBOR_PORT=4399
# 留空使用用户目录下 .release-harbor；测试和开发可指定隔离目录。
# RELEASE_HARBOR_DATA_DIR=/absolute/path/to/local-data
# 可选：团队登录的精确 HTTPS 隧道地址。可在仓库根目录 .env 中设置此项。
# RELEASE_HARBOR_TUNNEL_ORIGIN=https://releases.example.com
