{
  "name": "release-harbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm typecheck && pnpm --filter @release-harbor/web build && tsx scripts/build-issue-assets.ts",
    "start": "tsx apps/api/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:smoke": "node scripts/smoke.mjs",
    "credentials": "tsx packages/runner-local/src/credentials-cli.ts"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "tsx": "4.23.15",
    "prettier": "3.5.3",
    "@types/node": "24.10.0",
    "@playwright/test": "1.64.1"
  }
}
